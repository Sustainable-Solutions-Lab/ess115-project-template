{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "US wildland acres burned per year, 1983-2025 (NIFC). Steps change the params below.",
  "height": 340,
  "params": [
    {"name": "hl_start", "value": 0, "description": "First year to highlight (0 = highlight every year)"},
    {"name": "hl_end", "value": 0, "description": "Last year to highlight"},
    {"name": "show_means", "value": 0, "description": "0 = no averages, 1 = 1983-1999 average, 2 = both averages"},
    {"name": "note_year", "value": 0, "description": "Year to label (0 = none)"},
    {"name": "x_min", "value": 1983, "description": "First year shown (zoom)"},
    {"name": "x_max", "value": 2025, "description": "Last year shown (zoom)"}
  ],
  "data": {"url": "data/nifc_us_wildfires.csv", "format": {"type": "csv"}},
  "transform": [
    {"calculate": "toNumber(datum.year)", "as": "year"},
    {"calculate": "toNumber(datum.acres) / 1e6", "as": "acres_m"},
    {"calculate": "datum.year - 0.38", "as": "x0"},
    {"calculate": "datum.year + 0.38", "as": "x1"},
    {"calculate": "datum.year < 2000 ? 1 : 2", "as": "period"}
  ],
  "encoding": {
    "x": {
      "field": "x0", "type": "quantitative", "title": null,
      "scale": {"domain": {"expr": "[x_min - 0.6, x_max + 0.6]"}, "nice": false, "zero": false},
      "axis": {"format": "d", "tickMinStep": 1, "labelOverlap": true, "tickCount": 8}
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "clip": true, "cornerRadiusTopLeft": 2, "cornerRadiusTopRight": 2},
      "encoding": {
        "x2": {"field": "x1"},
        "y": {"field": "acres_m", "type": "quantitative", "title": null,
              "scale": {"domain": [0, 11]}, "axis": {"format": ".0f", "tickCount": 6, "labelExpr": "datum.value + 'M'"}},
        "y2": {"datum": 0},
        "color": {
          "condition": {"test": "hl_start == 0 || (datum.year >= hl_start && datum.year <= hl_end)", "value": "token:accent"},
          "value": "token:context"
        },
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "acres", "type": "quantitative", "title": "Acres burned", "format": ","},
          {"field": "fires", "type": "quantitative", "title": "Fires", "format": ","}
        ]
      }
    },
    {
      "transform": [
        {"filter": "show_means >= datum.period"},
        {"aggregate": [{"op": "mean", "field": "acres_m", "as": "mean_m"},
                       {"op": "min", "field": "x0", "as": "start"},
                       {"op": "max", "field": "x1", "as": "end"}],
         "groupby": ["period"]}
      ],
      "layer": [
        {
          "mark": {"type": "rule", "clip": true, "strokeWidth": 2, "color": "token:ink", "strokeDash": [5, 3]},
          "encoding": {"x": {"field": "start"}, "x2": {"field": "end"}, "y": {"field": "mean_m", "type": "quantitative"}}
        },
        {
          "transform": [{"calculate": "'Average ' + format(datum.mean_m, '.1f') + 'M'", "as": "label"}],
          "mark": {"type": "text", "clip": true, "align": "left", "baseline": "bottom", "dx": 2, "dy": -4,
                   "fontWeight": 600, "color": "token:ink"},
          "encoding": {"x": {"field": "start"}, "y": {"field": "mean_m", "type": "quantitative"}, "text": {"field": "label"}}
        }
      ]
    },
    {
      "transform": [
        {"filter": "datum.year == note_year"},
        {"calculate": "datum.year + ': ' + format(datum.acres_m, '.1f') + 'M acres'", "as": "label"},
        {"calculate": "datum.year", "as": "xc"}
      ],
      "mark": {"type": "text", "clip": true, "baseline": "bottom", "dy": -6, "fontWeight": 600, "color": "token:ink",
               "align": {"expr": "note_year > (x_min + x_max) / 2 + 4 ? 'right' : (note_year < (x_min + x_max) / 2 - 4 ? 'left' : 'center')"}},
      "encoding": {"x": {"field": "xc"}, "y": {"field": "acres_m", "type": "quantitative"}, "text": {"field": "label"}}
    }
  ]
}
